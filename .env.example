# Copy to .env (`make up` does this for you). Local development values only;
# production secrets come from AWS Secrets Manager.
LOG_LEVEL=INFO

POSTGRES_PASSWORD=change-me-postgres
AUTH_DB_PASSWORD=change-me-auth
SYNC_DB_PASSWORD=change-me-sync
PORTFOLIO_DB_PASSWORD=change-me-portfolio
ANALYTICS_DB_PASSWORD=change-me-analytics
RISK_DB_PASSWORD=change-me-risk
AI_DB_PASSWORD=change-me-ai
NOTIFICATIONS_DB_PASSWORD=change-me-notifications

# Optional: extra root CA trusted during image builds, for machines behind a
# TLS-inspecting proxy or antivirus. Path is relative to infra/.
# EXTRA_CA_FILE=../.certs/local-ca.pem
