{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-ai.dev/schemas/ai.query.created.v1.json",
  "title": "ai.query.created.v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conversation_id",
    "message_id",
    "tool_calls"
  ],
  "properties": {
    "conversation_id": {
      "type": "string",
      "format": "uuid"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "tool_calls": {
      "type": "integer",
      "minimum": 0
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0
    }
  }
}
