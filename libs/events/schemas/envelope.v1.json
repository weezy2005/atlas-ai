{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-ai.dev/schemas/envelope.v1.json",
  "title": "Event envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "user_id",
    "producer",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z_]+(\\.[a-z_]+)+\\.v[0-9]+$"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "producer": {
      "type": "string"
    },
    "trace_context": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "W3C traceparent/tracestate"
    },
    "payload": {
      "type": "object"
    }
  }
}
