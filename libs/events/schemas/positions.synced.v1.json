{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-ai.dev/schemas/positions.synced.v1.json",
  "title": "positions.synced.v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "account_id",
    "sync_run_id",
    "as_of",
    "cash",
    "positions"
  ],
  "properties": {
    "account_id": {
      "type": "string",
      "format": "uuid"
    },
    "sync_run_id": {
      "type": "string",
      "format": "uuid"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "cash": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "description": "Decimal encoded as string to avoid float rounding"
    },
    "positions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "quantity",
          "cost_basis"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "quantity": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d+)?$",
            "description": "Decimal encoded as string to avoid float rounding"
          },
          "cost_basis": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d+)?$",
            "description": "Decimal encoded as string to avoid float rounding"
          },
          "market_value": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d+)?$",
            "description": "Decimal encoded as string to avoid float rounding"
          },
          "asset_class": {
            "type": "string"
          }
        }
      }
    }
  }
}
